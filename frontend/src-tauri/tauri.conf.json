{
  "$schema": "https://raw.githubusercontent.com/nicktomlin/tauri/v2/tooling/cli/schema.json",
  "productName": "ClipboardHistoryManager",
  "version": "2.0.0",
  "identifier": "com.yzh2653.clipboard-history",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "历史剪贴板管理器",
        "width": 900,
        "height": 700,
        "minWidth": 500,
        "minHeight": 400,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
